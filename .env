# Safe to commit — this is the publishable/anon key, meant for client-side
# use. Row-level security in Postgres is the actual authorization boundary,
# not secrecy of this key. Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://jiohhwahvzajvidbiqnm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_69dScqBVzWVq_SLUJQUKNA_cEhBJfnk

# RevenueCat public SDK key — this is the client-facing "SDK API key,"
# safe to commit, same category as the Supabase key above; never the
# secret key (RevenueCat keeps those in a separate "Secret API keys"
# section specifically because those must never be client-side/GitHub).
